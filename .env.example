# Copie ce fichier en .env et renseigne uniquement les fournisseurs que tu utilises.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
SAMBANOVA_API_KEY=

# NVIDIA NIM (hébergé) : appels explicites uniquement, désactivés par défaut.
# Vérifie les crédits/tarifs de ton compte avant d'activer NVIDIA_ENABLED.
NVIDIA_API_KEY=
NVIDIA_MODEL_ID=
NVIDIA_ENABLED=false

# Optionnel, providers payants (jamais utilisés automatiquement)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optionnel : plafond mensuel $ pour les providers payants (défaut 0.0 = appels premium désactivés)
MAX_MONTHLY_SPEND_USD=

# Optionnel mais fortement recommandé dès que le serveur est exposé hors de ta machine
# (ex: via un tunnel) : un code d'accès partagé, généré par ex. avec
# python -c "import secrets; print(secrets.token_urlsafe(12))"
APP_ACCESS_TOKEN=
